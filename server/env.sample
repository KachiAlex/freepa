# Server
PORT=8080
DATABASE_URL=postgres://freepa:freepa@localhost:5432/freepa
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=7d

# Files
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080

# Frontend build location (relative to server/)
FRONTEND_DIST=../frontend/dist

# Payment providers
FLUTTERWAVE_SECRET_KEY=flw-sk-...
FLUTTERWAVE_WEBHOOK_SECRET=replace-with-flutterwave-webhook-secret
PAYSTACK_SECRET_KEY=psk_live_...
PAYSTACK_WEBHOOK_SECRET=replace-with-paystack-webhook-secret
PAYMENT_SUCCESS_REDIRECT=https://your-domain.com/payments/success

# External REST API (/api/v1) — optional
INVOICE_API_KEY=generated-key
