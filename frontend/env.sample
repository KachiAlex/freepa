# Only needed when the API runs on a different origin (e.g. local dev
# with `vite` on :5173 and the Node server on :8080 — the dev proxy in
# vite.config.ts already covers this, so it's optional for local work).
# Leave unset for same-origin deployments where the server hosts the
# built frontend.
VITE_API_URL=http://localhost:8080

# Optional label shown in the dashboard sidebar.
VITE_APP_NAME=freepa
